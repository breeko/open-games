{
  "name": "open-games",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "bun test ./tests",
    "audit": "bun run audit:garden-guard",
    "test:garden-guard": "bun test ./tests/games/garden-guard",
    "test:kingdom-rush": "bun test ./tests/games/kingdom-rush",
    "check:art:garden-guard": "python3 scripts/games/garden-guard/verify-reference-sprites.py",
    "audit:garden-guard": "bun scripts/games/garden-guard/audit-reference.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.6"
}
